# Editor settings, matching what the commit hooks and the formatter enforce (.pre-commit-config.yaml, ruff.toml):
# UTF-8, LF line endings, one final newline, no trailing whitespace, spaces not tabs; Python per the Google Python
# Style Guide (4-space indents, 80-column lines, formatted by ruff format). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = off

[*.py]
max_line_length = 80

[*.{yml,yaml,toml}]
indent_size = 2

[*.vrt.in]
# GDAL's VRT XML
indent_size = 2

[{*.json,*.geojson,.secrets.baseline}]
# written by the scripts and tools (json.dump, GDAL, detect-secrets), each file indented as its writer indents it
indent_size = unset

[*.md]
# trailing double spaces are Markdown line breaks; the whitespace hook keeps them (--markdown-linebreak-ext=md)
trim_trailing_whitespace = false

[resources/ttb/federal-register-*.xml]
# the Federal Register's own file, kept byte for byte (the whitespace hooks skip it too)
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
